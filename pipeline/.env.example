# LLM (Gemini 2.5 Flash via Google AI Studio)
PIPELINE_LLM_PROVIDER=google
PIPELINE_LLM_MODEL_ID=gemini-2.5-flash
PIPELINE_LLM_API_KEY=

# Concurrency
PIPELINE_LLM_MAX_CONCURRENT=20

# Persistence
PIPELINE_JOBS_DIR=./jobs

# Server
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8002
PIPELINE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
