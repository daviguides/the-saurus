# Langfuse (local)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# LLM API keys (for synthetic generation + rollback judge path)
GOOGLE_API_KEY=your-google-ai-studio-key

# Eval judge (independent model family from both pipeline/Gemini and
# assistant/OpenAI generators — avoids same-family self-preference bias)
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-anthropic-api-key

# Sampling rate for production scoring (0.0-1.0)
LANGFUSE_SAMPLE_RATE=0.10
